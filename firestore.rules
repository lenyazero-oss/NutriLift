rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 本人(uid 一致)か
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    // 文字列で、長さが 1〜max
    function str(v, max) {
      return v is string && v.size() >= 1 && v.size() <= max;
    }
    // 数値で、min 以上 max 以下
    function num(v, min, max) {
      return v is number && v >= min && v <= max;
    }
    // 任意項目: 無いか、正の数値(目標値用)
    function goal(d, k) {
      return !(k in d) || num(d[k], 0, 99999); // 画面は 0 より大きい値のみだが、丸めで 0 になる場合は拒否しない
    }

    // 検証はアプリ側の入力制限より緩め(正常な操作を拒否しないため)。数値の上限は異常値(桁あふれ)を防ぐ程度。
    // 栄養素を追加したら、goals の許可キー(下)にも同じ key を足すこと。
    // 栄養素のマップ(nutrients / n)は、将来の栄養素追加に備えてキーは固定せず、数だけ制限する。

    // 食事記録(スナップショット)
    function validMeal(d) {
      return d.keys().hasOnly(['date', 'slot', 'foodId', 'source', 'recipeId', 'name', 'grams', 'qtyText', 'nutrients', 'createdAt'])
        && d.keys().hasAll(['date', 'slot', 'source', 'name', 'grams', 'qtyText', 'nutrients'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.slot in ['morning', 'noon', 'night', 'snack']
        && d.source in ['table', 'custom', 'recipe']
        && (d.get('foodId', null) == null || str(d.foodId, 100))
        && (d.get('recipeId', null) == null || str(d.recipeId, 100))
        && str(d.name, 200)
        && num(d.grams, 0, 1000000000)
        && d.qtyText is string && d.qtyText.size() <= 100
        && d.nutrients is map && d.nutrients.size() <= 30
        && d.get('createdAt', request.time) is timestamp;
    }

    // レシピ: { name, servings, items:[…], totalWeight(任意。完成重量g) }
    function validRecipe(d) {
      return d.keys().hasOnly(['name', 'servings', 'items', 'totalWeight', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'servings', 'items'])
        && (!('totalWeight' in d) || num(d.totalWeight, 0.1, 1000000000))
        && str(d.name, 100)
        && d.servings is number && d.servings > 0 && d.servings <= 1000000000
        && d.items is list && d.items.size() <= 200
        && d.get('createdAt', request.time) is timestamp
        && d.get('updatedAt', request.time) is timestamp;
    }

    // 自作食材: { name, n(100gあたり), units:[{name,g}] }
    function validCustomFood(d) {
      return d.keys().hasOnly(['name', 'n', 'units', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['name', 'n', 'units'])
        && str(d.name, 100)
        && d.n is map && d.n.size() <= 30
        && d.units is list && d.units.size() <= 10
        && d.get('createdAt', request.time) is timestamp
        && d.get('updatedAt', request.time) is timestamp;
    }

    // 体重: weights/{日付} = { date, kg }
    function validWeight(d, id) {
      return d.keys().hasOnly(['date', 'kg', 'updatedAt'])
        && d.keys().hasAll(['date', 'kg'])
        && d.date == id && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && num(d.kg, 20, 400)
        && d.get('updatedAt', request.time) is timestamp;
    }

    // 成分表の食材の表示名: { name }(元の名前は変えない)
    function validDisplayName(d) {
      return d.keys().hasOnly(['name', 'updatedAt'])
        && d.keys().hasAll(['name'])
        && str(d.name, 100)
        && d.get('updatedAt', request.time) is timestamp;
    }

    // 成分表の食材の単位の上書き: { units:[{name,g}] }
    function validUnitOverride(d) {
      return d.keys().hasOnly(['units', 'updatedAt'])
        && d.units is list && d.units.size() <= 10
        && d.get('updatedAt', request.time) is timestamp;
    }

    // 目標値: 栄養素の key ごとの正の数値(merge 保存なので、保存後の全体に対する検証になる)
    function validGoals(d) {
      return d.keys().hasOnly(['protein', 'kcal', 'fat', 'carb', 'fiber', 'calcium', 'iron', 'zinc', 'magnesium', 'vitaminB6', 'vitaminD', 'updatedAt'])
        && goal(d, 'protein') && goal(d, 'kcal') && goal(d, 'fat') && goal(d, 'carb') && goal(d, 'fiber')
        && goal(d, 'calcium') && goal(d, 'iron') && goal(d, 'zinc') && goal(d, 'magnesium')
        && goal(d, 'vitaminB6') && goal(d, 'vitaminD')
        && d.get('updatedAt', request.time) is timestamp;
    }

    // 身体情報(目標値の自動計算用)
    function validProfile(d) {
      return d.keys().hasOnly(['sex', 'age', 'height', 'weight', 'activity', 'aim', 'updatedAt'])
        && d.keys().hasAll(['sex', 'age', 'height', 'weight', 'activity', 'aim'])
        && d.sex in ['male', 'female']
        && d.activity in ['low', 'light', 'mid', 'high']
        && d.aim in ['bulk', 'keep', 'cut']
        && num(d.age, 1, 150) && num(d.height, 1, 300) && num(d.weight, 1, 500)
        && d.get('updatedAt', request.time) is timestamp;
    }

    // 本人(uid 一致)のみ users/{uid}/ 配下を読み書き可。書き込みは形式を検証し、削除は検証なし。
    match /users/{uid} {
      match /meals/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validMeal(request.resource.data);
      }
      match /recipes/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validRecipe(request.resource.data);
      }
      match /customFoods/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validCustomFood(request.resource.data);
      }
      match /weights/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validWeight(request.resource.data, id);
      }
      match /displayNames/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validDisplayName(request.resource.data);
      }
      match /unitOverrides/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validUnitOverride(request.resource.data);
      }
      match /settings/goals {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validGoals(request.resource.data);
      }
      match /settings/profile {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validProfile(request.resource.data);
      }
    }
    // それ以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
