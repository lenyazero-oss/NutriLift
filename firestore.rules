rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 本人(uid 一致)のみ users/{uid}/ 配下を読み書き可
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // それ以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
