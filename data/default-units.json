{
  "_comment": "単位の初期値。match の語がすべて食品名に含まれ、exclude の語を含まない食材に適用される(上から最初に一致したもの)。値は目安で、アプリの食材マスタから食材ごとに上書きできる。",
  "rules": [
    { "match": ["鶏卵", "全卵", "生"], "units": [{ "name": "個", "g": 50 }] },
    { "match": ["水稲めし", "精白米"], "units": [{ "name": "茶碗1杯", "g": 150 }, { "name": "合(炊飯後)", "g": 330 }] },
    { "match": ["にわとり", "若どり", "むね", "皮なし", "生"], "units": [{ "name": "枚", "g": 250 }] },
    { "match": ["にわとり", "若どり", "もも", "皮なし", "生"], "units": [{ "name": "枚", "g": 250 }] },
    { "match": ["食パン"], "exclude": ["耳", "焼き", "トースト"], "units": [{ "name": "枚(6枚切)", "g": 60 }] },
    { "match": ["バナナ", "生"], "units": [{ "name": "本", "g": 100 }] },
    { "match": ["普通牛乳"], "units": [{ "name": "コップ1杯", "g": 200 }] },
    { "match": ["納豆", "糸引き"], "units": [{ "name": "パック", "g": 45 }] }
  ]
}
